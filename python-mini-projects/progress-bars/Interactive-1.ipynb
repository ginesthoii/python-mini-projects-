    "import time, sys\n",
    "\n",
    "for i in range(101):\n",
    "    bar = '█' * (i // 2) + '-' * (50 - i // 2)\n",
    "    sys.stdout.write(f\"\\rDownloading |{bar}| {i}%\")\n",
    "    sys.stdout.flush()\n",
    "    time.sleep(0.05)\n",
    "\n",
    "print(\"\\nDone!\")"
   ]
